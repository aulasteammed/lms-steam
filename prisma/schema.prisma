model Course {
  id              String  @id @default(auto()) @map("_id") @db.ObjectId
  userId          String
  title           String
  description     String?
  imageUrl        String?
  previousSkills  String?
  developedSkills String?
  level           String?
  price           Float?

  isPublished Boolean @default(false)

  modules         Module[]
  attachments     Attachment[]
  registered      Registration[]
  certificates    Certificate[]
  ratings         Rating[]
  courseCategories CourseCategory[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isPublished, createdAt])
}

model Category {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  name            String   @unique
  courseCategories CourseCategory[]
}

model CourseCategory {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId

  courseId        String   @db.ObjectId
  course          Course   @relation(fields: [courseId], references: [id])

  categoryId      String   @db.ObjectId
  category        Category @relation(fields: [categoryId], references: [id])

  createdAt       DateTime @default(now())

  @@unique([courseId, categoryId])
  @@index([categoryId])
}

model Attachment {
  id              String @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  url             String

  courseId        String @db.ObjectId
  course          Course @relation(fields: [courseId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Module {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  title           String
  description     String?
  videoUrl        String?
  videoTranscript String?
  position        Int
  isPublished     Boolean  @default(false)
  isEnabled       Boolean  @default(false)

  isEvaluable     Boolean  @default(false)
  evaluationMethod EvaluationType?

  courseId        String   @db.ObjectId
  course          Course   @relation(fields: [courseId], references: [id])

  userProgress    UserProgress[]
  evaluation      Evaluation?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([courseId, isPublished])
}

model UserProgress {
  id              String @id @default(auto()) @map("_id") @db.ObjectId
  userId          String

  moduleId        String  @db.ObjectId
  module          Module @relation(fields: [moduleId], references: [id])

  isCompleted     Boolean @default(false)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, moduleId])
}

model Registration {
  id              String @id @default(auto()) @map("_id") @db.ObjectId
  userId          String

  courseId        String @db.ObjectId
  course          Course @relation(fields: [courseId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, courseId])
}

model Rating {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  userId          String
  courseId        String   @db.ObjectId
  course          Course   @relation(fields: [courseId], references: [id])

  rating          Int
  comment         String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum EvaluationType {
  sequence
  locate
  single
  multiple
  open
}

enum QuestionType {
  sequence
  single
  multiple
  open
}

model Evaluation {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  maxAttempts     Int?

  moduleId        String   @unique @db.ObjectId
  module          Module   @relation(fields: [moduleId], references: [id])

  isPublished     Boolean  @default(false)

  questions       Question[]
  evaluationResults EvaluationResult[]
  retryGrants     EvaluationRetryGrant[]
  retryEmailLogs  EvaluationRetryEmailLog[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Question {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  title           String
  type            QuestionType?

  evaluationId    String   @db.ObjectId
  evaluation      Evaluation   @relation(fields: [evaluationId], references: [id])

  answers         Answer[]
  selectedAnswers SelectedAnswer[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Answer {
  id              String     @id @default(auto()) @map("_id") @db.ObjectId
  title           String

  questionId      String     @db.ObjectId
  question        Question   @relation(fields: [questionId], references: [id])
  isCorrect       Boolean    @default(false)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model EvaluationResult {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  userId              String

  evaluationId        String   @db.ObjectId
  evaluation          Evaluation @relation(fields: [evaluationId], references: [id])

  answers             SelectedAnswer[]

  attempt             Int      @default(0)
  score               Float    @default(0)
  completedAt         DateTime @default(now())
}

model RetryAccessCode {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  code                String   @unique
  isActive            Boolean  @default(true)
  usedByUserId        String?
  usedForEvaluationId String?  @db.ObjectId
  usedAt              DateTime?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model EvaluationRetryGrant {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  userId              String

  evaluationId        String   @db.ObjectId
  evaluation          Evaluation @relation(fields: [evaluationId], references: [id])

  extraAttempts       Int      @default(2)
  codeUsed            String
  createdAt           DateTime @default(now())
}

model EvaluationRetryEmailLog {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  userId              String

  evaluationId        String   @db.ObjectId
  evaluation          Evaluation @relation(fields: [evaluationId], references: [id])

  attempt             Int
  sentAt              DateTime @default(now())

  @@unique([userId, evaluationId, attempt])
}

model SelectedAnswer {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  title               String
  evaluationResultId  String @db.ObjectId
  evaluationResult    EvaluationResult @relation(fields: [evaluationResultId], references: [id])

  questionId          String @db.ObjectId
  question            Question @relation(fields: [questionId], references: [id])

  isCorrect           Boolean
}

model Certificate {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  userId          String
  courseId        String   @db.ObjectId
  course          Course   @relation(fields: [courseId], references: [id])
  issuedAt        DateTime @default(now())
  certificateUrl  String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Event {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  title         String
  userId        String
  description   String?
  imageUrl      String?
  startDateTime DateTime
  endDateTime   DateTime
  link          String
  location      String
  clickCount    Int       @default(0)
  createdAt     DateTime  @default(now())
  
}

enum ArticleStatus {
  draft
  published
  archived
}

enum ArticleTemplate {
  cover_person
  full_article
  profile_simple
  news_short
}

enum SocialPlatform {
  instagram
  facebook
  linkedin
  x
  github
  website
}

model Article {
  id           String          @id @default(auto()) @map("_id") @db.ObjectId
  slug         String          @unique

  title        String
  subtitle     String?
  hookPhrase   String?
  coverImage   String? 

  authorName            String
  authorBio             String?
  authorPhoto           String?         
  authorSocialPlatform  SocialPlatform?
  authorSocialUrl       String?

  template     ArticleTemplate  @default(cover_person)
  accentColor  String           @default("#e8622a")
  darkColColor String           @default("#12110f")

  blocks       Json[]

  //publishedBy  String

  status       ArticleStatus   @default(draft)
  publishedAt  DateTime?
  views        ArticleView[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model ArticleView {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  articleId String   @db.ObjectId
  article   Article  @relation(fields: [articleId], references: [id])
  userId    String?  
  sessionId String? 
  viewedAt  DateTime @default(now())
}


enum TimelineEntryType {
  project
  participation
  alliance
}

enum TimelineEntryStatus {
  draft
  published
}

enum ParticipationModality {
  in_person
  virtual
  hybrid
}

enum TimelineDocumentKind {
  newspaper
  magazine
  booklet
  book
  report
  deliverable
  other
}


type TimelineImage {
  url    String
  alt    String
  credit String?
}


type TimelinePerson {
  name         String
  role         String
  contribution String?
  /// Una o dos frases: quién es la persona.
  bio          String?
}


type TimelineStory {
  title      String
  paragraphs String[]
}

type TimelineQuote {
  text   String
  author String
  role   String?
}

/// Una página de un documento, como imagen para el visor.
type TimelineDocumentPage {
  url      String
  /// Versión de mayor resolución para el zoom. Vacío si se guarda un solo tamaño.
  urlLarge String?
}

/// Un registro del mapa y la línea de tiempo: proyecto, participación o alianza.
model TimelineEntry {
  id     String              @id @default(auto()) @map("_id") @db.ObjectId
  type   TimelineEntryType
  status TimelineEntryStatus @default(draft)

  /// Forma la dirección de la página: /proyectos/<slug>. Lleva el año de
  /// finalización (entre-aguas-2026) y no cambia al editar el título.
  slug             String   @unique
  /// Direcciones anteriores, que redirigen a la actual. Se llena cuando un
  /// registro en curso se cierra y su slug gana el año.
  previousSlugs    String[]
  /// Nombre del proyecto, de la participación o de la alianza.
  title            String
  /// Máximo 250 caracteres.
  shortDescription String

  /// Año de inicio. En participaciones, el año en que ocurrió.
  startYear Int
  /// Año de cierre. Vacío = en curso (se ubica en el año actual).
  endYear   Int?

  /// "Santo Domingo Savio, Comuna 1, Medellín".
  locationText String
  /// Vacías en participaciones virtuales: van en la línea de tiempo, no en el mapa.
  latitude     Float?
  longitude    Float?

  images TimelineImage[]

  /// Proyecto: instituciones involucradas. Alianza: la institución aliada.
  /// Participación: quien organizó, si se conoce.
  institutionIds String[]              @db.ObjectId
  institutions   TimelineInstitution[] @relation(fields: [institutionIds], references: [id])

  // ── Solo proyectos ──
  people           TimelinePerson[]
  story            TimelineStory?
  quote            TimelineQuote?
  acknowledgements String?
  externalLinkUrl  String?
  externalLinkText String?
  documents        TimelineDocument[]

  // ── Solo participaciones ──
  participationDate DateTime?
  modality          ParticipationModality?
  /// Por qué se participó.
  reason            String?
  speakerName       String?
  speakerRole       String?

  // ── Participaciones y alianzas ──
  /// Proyectos o participaciones con los que se relaciona este registro.
  relatedEntryIds String[] @db.ObjectId

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Mapa y línea de tiempo: lo publicado, por tipo.
  @@index([status, type])
  // Página de un proyecto: participaciones y alianzas que lo mencionan.
  @@index([relatedEntryIds])
  // Todo lo hecho con una institución.
  @@index([institutionIds])
  // Redirección desde una dirección anterior.
  @@index([previousSlugs])
}

/// Institución u organización. Se registra una sola vez y se enlaza desde
/// los proyectos, participaciones y alianzas en los que aparece.
model TimelineInstitution {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  /// Nombre completo, sin siglas sueltas.
  name    String  @unique
  /// Evita duplicados por tildes o mayúsculas: se arma a partir del nombre.
  slug    String  @unique
  /// Sigla, si tiene: "UNAL".
  acronym String?
  website String?

  entryIds String[]        @db.ObjectId
  entries  TimelineEntry[] @relation(fields: [entryIds], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Documento de un proyecto que se lee en el visor y se descarga:
/// periódico, revista, informe u otro entregable.
model TimelineDocument {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  entryId String        @db.ObjectId
  entry   TimelineEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  /// Forma la dirección del visor: /proyectos/<slug-proyecto>/lector/<slug>.
  slug        String
  title       String
  kind        TimelineDocumentKind
  description String?

  /// PDF original, para la descarga.
  pdfUrl       String
  pdfSizeBytes Int?

  /// Páginas convertidas a imagen al subir el PDF.
  pages      TimelineDocumentPage[]
  pageCount  Int
  /// Tamaño de una página en píxeles; da la proporción de la hoja al visor.
  pageWidth  Int
  pageHeight Int

  /// Orden dentro del proyecto. El primero que no sea informe va en el encabezado.
  position Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Visor: un documento por la dirección /proyectos/<proyecto>/lector/<slug>.
  @@unique([entryId, slug])
  // Página del proyecto: sus documentos, ya ordenados.
  @@index([entryId, position])
}
